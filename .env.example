# Local development
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DEBUG=True
ALLOWED_HOSTS = [
    host.strip()
    for host in os.getenv(
        "ALLOWED_HOSTS",
        "127.0.0.1,localhost"
    ).split(",")
    if host.strip()
]
CSRF_TRUSTED_ORIGINS=

# Routing
ORS_API_KEY=your_openrouteservice_key_here
GOPLAN_BIKE_ROUTER_URL=https://routing.openstreetmap.de/routed-bike/route/v1/driving
GOPLAN_FOOT_ROUTER_URL=https://routing.openstreetmap.de/routed-foot/route/v1/driving
GOPLAN_ROUTER_TIMEOUT=25